# Paquetes de la ISO pixmatic (sustituye a archiso/packages_desktop.x86_64).
# Solo consola: sin Plasma, sin Calamares, sin herramientas de rescate.

# Sistema base y arranque del live (solo UEFI: el binario de systemd-boot sale
# del paquete systemd y su única entrada usa linux-cachyos). Un único kernel,
# sin -lts ni ZFS. Los paquetes salen de los repos x86-64-v3 (pacman.conf del
# overlay): la ISO no arranca en CPUs sin x86-64-v3.
base
linux-cachyos
linux-firmware
linux-firmware-marvell
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils
nbd
efibootmgr

# Repositorios y claves
archlinux-keyring
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
cachyos-v4-mirrorlist
cachyos-rate-mirrors

# Instalador propio pixmatic-install: pacstrap y arch-chroot, chwd, y jq para
# leer settings.jsonc
arch-install-scripts
chwd
jq

# Discos y sistemas de ficheros: solo lo que usa el instalador propio (GPT con
# sgdisk/sfdisk, ESP vfat, btrfs, LUKS2). e2fsprogs lo arrastra krb5 de todos
# modos. nvme-cli: borrado seguro del disco antes de particionar
# (nvme format --ses / nvme sanitize); blkdiscard (util-linux) para el resto.
btrfs-progs
cryptsetup
dosfstools
e2fsprogs
gptfdisk
nvme-cli

# Red
networkmanager
wpa_supplicant
iw
wireless-regdb
openssh
systemd-resolvconf

# Utilidades de consola
sudo
nano
less
bash-completion
