#!/bin/bash
#
# pixmatic-install: instalador automático de CachyOS (primera versión, de
# pruebas). Se ejecuta en el live de la ISO pixmatic.
#
# Replica el sistema que deja Calamares (cachyos-staging) con la forma de
# New-Cli-Installer (NCI): pasos lineales, un único pacstrap y arch-chroot.
# Las decisiones y su motivo están en pixmatic_autoinstall/docs/decisiones.md;
# las referencias "Cal §N" / "NCI §N" son los pasos de las auditorías de
# docs/auditoria-calamares-base.md y docs/auditoria-new-cli-installer-base.md.
#
# Alcance de esta versión: sin escritorio, LUKS2 con contraseña vacía (se
# abre sola al arrancar), con [chaotic-aur] y sin [omarchy], ufw sin activar.
#
# Uso: pixmatic-install <disco>    ¡BORRA EL DISCO sin preguntar!
#   Lo ejecuta pixmatic-menu (el menú del live) con el disco elegido de su
#   lista, tras confirmar el borrado; al terminar, el menú ofrece apagar,
#   reiniciar o salir a la consola. La configuración es
#   /etc/pixmatic/settings.jsonc, copia tal cual de
#   pixmatic_autoinstall/settings.jsonc (con sus comentarios, que describen
#   las claves, para editarlo en el live). Se quitan las líneas que empiezan
#   por // y el resto tiene que ser JSON.
#
# Si falla, deja todo montado en /mnt (y el LUKS abierto) para depurar;
# volver a ejecutarlo empieza de cero.

set -Eeuo pipefail
trap 'echo "ERROR: line ${LINENO}: ${BASH_COMMAND}" >&2' ERR

# Entrada UEFI de la UKI, compartida con pixmatic-rescue
. /usr/local/lib/pixmatic/boot.sh

# --- Configuración ----------------------------------------------------------

# Lo configurable sale de settings.jsonc; lo demás (particionado, kernel,
# bootloader, grupos, shell fish...) es fijo, según docs/decisiones.md.
(( $# == 1 )) || { echo "Usage: pixmatic-install <disk>  (normally run from pixmatic-menu)" >&2; exit 1; }
disk="$1"
config="/etc/pixmatic/settings.jsonc"
[[ -r ${config} ]] || { echo "ERROR: cannot read ${config}" >&2; exit 1; }
# Solo se quitan líneas de comentario completas, para no tocar valores que
# contengan // (p. ej. URLs). "|| true": grep sale con 1 si no queda nada
json="$(grep -Ev '^[[:space:]]*//' "${config}" || true)"
jq -e 'type == "object"' <<< "${json}" > /dev/null 2>&1 \
    || { echo "ERROR: ${config}: not a JSON object once // lines are removed" \
              "(check: grep -Ev '^[[:space:]]*//' ${config} | jq .)" >&2; exit 1; }
# cfg <clave> [defecto]: sin defecto, la clave es obligatoria
cfg() {
    jq -r --arg k "$1" --arg d "${2-}" --argjson req "$(( $# < 2 ))" \
        'if has($k) then .[$k] elif $req == 1 then error("missing key: \($k)") else $d end' \
        <<< "${json}"
}

hostname="$(cfg hostname)"
locale="$(cfg locale)"
xkbmap="$(cfg xkbmap)"
console_keymap="$(cfg console_keymap "${xkbmap}")"
timezone="$(cfg timezone)"
mapfile -t extra_pkgs < <(jq -r '.extra_packages // [] | .[]' <<< "${json}")
username="$(cfg user_name)"
user_fullname="$(cfg user_fullname "")"
user_pass="$(cfg user_pass)"
root_pass="$(cfg root_pass)"

mnt="/mnt"
log="/var/log/pixmatic-install.log"   # en el live; se copia al target al final
mapper="root"                         # nombre que usa gpt-auto para la raíz LUKS
opts="noatime,compress=zstd:1"        # montaje de btrfs (Calamares en NVMe, NCI en SSD)

# Subvolúmenes (los de Calamares y NCI) y su punto de montaje. "@" es la raíz:
# se monta como subvolumen por defecto, sin unidad propia.
subvols=(@home:/home @root:/root @srv:/srv @cache:/var/cache @tmp:/var/tmp @log:/var/log)

# Paquetes del pacstrap único: las listas de Calamares (cachyos-staging) sin el
# kernel -lts, más snapper (de NCI). El microcódigo se añade según la CPU, y
# los de los grupos de netinstall, según additional_packages (abajo).
pkgs=(
    # Cal §7: pacstrap.conf (basePackages), sin systemd-boot-manager (arranque
    # directo con UKI, decisiones §9). Incluye los del grupo oculto "CachyOS
    # required" de netinstall (sin -lts).
    base base-devel btrfs-progs cachyos-hooks cachyos-keyring cachyos-mirrorlist
    cachyos-v4-mirrorlist cachyos-v3-mirrorlist cachyos-rate-mirrors cachyos-settings
    cryptsetup device-mapper diffutils dosfstools e2fsprogs efibootmgr exfatprogs
    f2fs-tools inetutils jfsutils less linux-cachyos linux-cachyos-headers
    linux-firmware logrotate lsb-release lvm2 man-db man-pages mdadm chwd mkinitcpio
    netctl os-prober perl python s-nail sudo sysfsutils texinfo usbutils which
    xfsprogs
    # NCI: snapper sin configurar (sin cachyos-snapper-support no hay snapshot);
    # sin btrfs-assistant (GUI Qt6; snapper y btrfs-progs bastan, decisiones §3)
    snapper
    # [chaotic-aur] (decisiones §6): llavero y mirrorlist en el sistema instalado
    chaotic-keyring chaotic-mirrorlist
    # settings.jsonc: extra_packages
    "${extra_pkgs[@]}"
)

# Grupos de netinstall de Calamares (Cal §14) según settings.jsonc
# (additional_packages): grupo -> (subgrupo ->) paquete: true | false. Se
# instalan los paquetes a true. Un grupo con todos a false no instala nada,
# como en Calamares, donde el grupo se desmarca solo al desmarcar todos sus
# paquetes (PackageTreeItem.cpp:210-238) y solo se recogen paquetes marcados
# (PackageModel.cpp:344-365).
tree="$(jq -c '.additional_packages // {}' <<< "${json}")"
jq -e '[paths(type != "object") as $p | select(($p | length) < 2 or (getpath($p) | type) != "boolean")] == []' \
    <<< "${tree}" > /dev/null \
    || { echo "ERROR: additional_packages: expected group -> package: true|false" >&2; exit 1; }
mapfile -t group_pkgs < <(jq -r '[paths(type == "boolean") as $p | select(getpath($p)) | $p[-1]] | unique[]' <<< "${tree}")
groups="$(jq -r '[paths(type == "boolean") as $p | select(getpath($p)) | $p[0]] | unique | join(", ")' <<< "${tree}")"
pkgs+=("${group_pkgs[@]}")

# Dependencia de lo fijo del script: fish es la shell del usuario (llega por
# cachyos-fish-config si está marcado)
[[ " ${pkgs[*]} " == *" cachyos-fish-config "* ]] || pkgs+=(fish)

# [chaotic-aur] (decisiones §6): claves de firma (huellas completas,
# verificadas en docs/auditoria-omarchy.md) y servidores para el pacstrap (el
# live no tiene chaotic-mirrorlist; el sistema instalado usa su Include). Los
# del chaotic-mirrorlist del paquete (20260428-1), en su orden: geo-mirror
# redirige a un mirror cercano y cdn-mirror queda de reserva; pacman pasa al
# siguiente si uno falla (cdn-mirror dio 503 continuos el 2026-11-17).
chaotic_keys=(EF925EA60F33D0CB85C44AD13056513887B78AEB   # firma chaotic-keyring
              67BF8CA6DA181643C9723B4ED6C9442437365605)  # firma el resto
chaotic_servers=('https://geo-mirror.chaotic.cx/$repo/$arch'
                 'https://cdn-mirror.chaotic.cx/$repo/$arch')

# --- Funciones ----------------------------------------------------------------

step() { printf '\n==> %s\n' "$*"; }
die() { echo "ERROR: $*" >&2; exit 1; }
in_target() { arch-chroot "${mnt}" "$@"; }

# CPU Zen 4/5 con AVX-512: copia de is_zen45() de detect-architecture (Cal §6)
is_zen45() {
    local family model
    family="$(grep -Po 'cpu family\s+:\s+\K([0-9]+)' /proc/cpuinfo | head -n1)"
    model="$(grep -Po 'model\s+:\s+\K([0-9]+)' /proc/cpuinfo | head -n1)"
    grep -q -w avx512f /proc/cpuinfo || return 1
    case "${family}" in
        $((0x19))) (( (model >= 0x10 && model <= 0x1f) || (model >= 0x60 && model <= 0xaf) )) ;;
        $((0x1a))) return 0 ;;
        *) return 1 ;;
    esac
}

# Monta un subvolumen y crea su unidad .mount (sin /etc/fstab, decisiones §4).
# What=/dev/gpt-auto-root es el enlace que crea udev para la raíz descubierta
# por gpt-auto (con LUKS, apunta a /dev/mapper/root). noatime es una opción
# por montaje (del VFS), así que va en cada unidad, como en el fstab de
# Calamares.
add_subvol_mount() {  # <subvolumen> <ruta>
    local sv="$1" path="$2" unit
    mkdir -p "${mnt}${path}"
    mount -o "subvol=${sv},${opts}" "/dev/mapper/${mapper}" "${mnt}${path}"

    unit="$(systemd-escape -p --suffix=mount "${path}")"
    mkdir -p "${mnt}/etc/systemd/system/local-fs.target.wants"
    cat > "${mnt}/etc/systemd/system/${unit}" <<EOF
[Unit]
Description=btrfs subvolume ${sv}

[Mount]
What=/dev/gpt-auto-root
Where=${path}
Type=btrfs
Options=subvol=${sv},${opts}

[Install]
WantedBy=local-fs.target
EOF
    # equivalente a systemctl enable
    ln -sf "../${unit}" "${mnt}/etc/systemd/system/local-fs.target.wants/${unit}"
}

# --- 0. Comprobaciones (antes de tocar nada) ----------------------------------

[[ ${EUID} -eq 0 ]] || die "Run as root"
[[ -b ${disk} && $(lsblk -dno TYPE "${disk}") == disk ]] || die "device ${disk} is not a disk"
[[ -d /sys/firmware/efi ]] || die "UEFI only"
curl -sf --retry 5 --retry-all-errors --retry-delay 3 -o /dev/null https://cachyos.org \
    || die "No network connection"

# Sin preguntas: las contraseñas se usan tal cual vienen en settings.jsonc
# y no se pide confirmación antes de borrar el disco
lsblk -o NAME,SIZE,TYPE,FSTYPE,MODEL "${disk}"

# A partir de aquí, todo a pantalla y al log
exec > >(tee -a "${log}") 2>&1
work="$(mktemp -d /tmp/pixmatic-install.XXXXXX)"
chmod 755 "${work}"   # pacman descarga como usuario alpm (DownloadUser)

# --- 1. Live: hora, llaveros y mirrors (Cal §0 y §5, NCI §0) -----------------

step "Preparing the live system"
timedatectl set-ntp true
pacman-key --init
pacman -Sy --noconfirm --needed archlinux-keyring cachyos-keyring
pacman-key --populate
# Ordena los mirrorlist del live; el target hereda los del live
cachyos-rate-mirrors || echo "WARNING: cachyos-rate-mirrors failed, using unsorted mirrors"
# Claves de [chaotic-aur] en el llavero del live: chaotic-keyring solo está en
# su repo, así que hay que confiar en ellas antes del pacstrap (que copia este
# llavero al target). Hacen falta las dos (decisiones §6).
pacman-key --recv-keys --keyserver hkps://keyserver.ubuntu.com "${chaotic_keys[@]}"
for key in "${chaotic_keys[@]}"; do
    pacman-key --lsign-key "${key}"
done

# --- 2. pacman.conf del target y validación de paquetes ----------------------

step "Generating pacman.conf"
# pacman-more.conf de la ISO (SigLevel global, Cal §6) con los repos
# optimizados para la CPU delante de [cachyos], como detect-architecture. La
# ISO solo arranca en x86-64-v3, así que v3 es el mínimo.
if is_zen45; then
    level=v4; repos=(cachyos-znver4 cachyos-core-znver4 cachyos-extra-znver4)
elif /lib/ld-linux-x86-64.so.2 --help | grep -q 'x86-64-v4 (supported'; then
    level=v4; repos=(cachyos-v4 cachyos-extra-v4 cachyos-core-v4)
else
    level=v3; repos=(cachyos-v3 cachyos-extra-v3 cachyos-core-v3)
fi
block=""
for r in "${repos[@]}"; do
    block+="[${r}]\nInclude = /etc/pacman.d/cachyos-${level}-mirrorlist\n\n"
done
# [chaotic-aur] al final, con la prioridad más baja: dos variantes, la del
# sistema instalado (Include del mirrorlist del paquete) y la del pacstrap
# (Server directo).
target_conf="${work}/pacman.conf"
pacconf="${work}/pacman-pacstrap.conf"
awk -v block="${block}" '/^\[cachyos\]$/ { printf "%s", block } { print }' \
    /etc/pacman-more.conf > "${target_conf}"
cp "${target_conf}" "${pacconf}"
printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' >> "${target_conf}"
{ printf '\n[chaotic-aur]\n'; printf 'Server = %s\n' "${chaotic_servers[@]}"; } >> "${pacconf}"
echo "Optimized repos: ${repos[*]}"

# Microcódigo según el fabricante de la CPU (Cal §7)
if grep -q GenuineIntel /proc/cpuinfo; then pkgs+=(intel-ucode); else pkgs+=(amd-ucode); fi

# Valida la lista entera contra los repos antes de borrar el disco
# (decisiones §5): resuelve dependencias sin instalar nada.
step "Validating package list"
echo "Package groups: ${groups}"
mkdir "${work}/db"
pacman --config "${pacconf}" --dbpath "${work}/db" -Sy
# La lista resuelta (con dependencias) es lo que quedará instalado. Si no se
# puede resolver, pacman explica el motivo (":: unable to satisfy dependency
# ...") en stdout, así que se muestra la salida capturada.
if ! resolved="$(pacman --config "${pacconf}" --dbpath "${work}/db" -Sp --print-format '%n' "${pkgs[@]}")"; then
    printf '%s\n' "${resolved}" >&2
    die "The package list cannot be installed from the current repos (see above); nothing has been written to ${disk}"
fi
resolved=" $(tr '\n' ' ' <<< "${resolved}") "
installs() { [[ ${resolved} == *" $1 "* ]]; }

# --- 3. Disco: GPT, ESP y LUKS2 (Cal §1, NCI §2, decisiones §4) ---------------

step "Partitioning ${disk}"
# Restos de una ejecución anterior que falló
umount -R "${mnt}" 2> /dev/null || true
cryptsetup close "${mapper}" 2> /dev/null || true

# Borra firmas de las particiones viejas y del disco, y descarta los bloques
# (en SSD/NVMe/virtio deja el disco a cero; en HDD no hace nada)
lsblk -lnpo NAME "${disk}" | tail -n +2 | xargs -r wipefs -af
wipefs -af "${disk}"
blkdiscard -f "${disk}" 2> /dev/null || true

# Tipos GPT de la Discoverable Partitions Specification: ESP y raíz x86-64
# (gpt-auto monta la ESP en /boot y desbloquea y monta la raíz sin fstab ni
# root= en la cmdline). La ESP empieza en 1 MiB (alineación de sgdisk, como
# NCI) y mide 2 GiB.
sgdisk --zap-all "${disk}"
sgdisk -n 1:0:+2G -t 1:C12A7328-F81F-11D2-BA4B-00A0C93EC93B \
       -n 2:0:0   -t 2:4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709 "${disk}"
udevadm settle
mapfile -t parts < <(lsblk -lnpo NAME "${disk}" | tail -n +2)
esp="${parts[0]}"
root="${parts[1]}"

step "Formatting"
mkfs.fat -F32 "${esp}"
# LUKS2 con los valores por defecto de cryptsetup (argon2id) y contraseña
# vacía: un keyfile de 0 bytes. Al arrancar la prueba try-empty-password
# (ver /etc/crypttab en el paso 4). La Fase 5 la sustituirá por TPM2.
keyfile="${work}/empty.key"
: > "${keyfile}"
cryptsetup -q luksFormat --type luks2 "${root}" "${keyfile}"
cryptsetup open --key-file "${keyfile}" "${root}" "${mapper}"
mkfs.btrfs -f "/dev/mapper/${mapper}"

# Subvolúmenes planos en el nivel superior. "@" queda como subvolumen por
# defecto: la raíz se monta sin subvol= y snapper rollback no necesita tocar
# el bootloader (decisiones §4).
step "Creating btrfs subvolumes"
mount "/dev/mapper/${mapper}" "${mnt}"
btrfs subvolume create "${mnt}/@"
for entry in "${subvols[@]}"; do
    btrfs subvolume create "${mnt}/${entry%%:*}"
done
btrfs subvolume set-default "${mnt}/@"
umount "${mnt}"

mount -o "${opts}" "/dev/mapper/${mapper}" "${mnt}"   # monta @
for entry in "${subvols[@]}"; do
    add_subvol_mount "${entry%%:*}" "${entry#*:}"
done
chmod 0750 "${mnt}/root"   # como Calamares (Cal §3)
# fmask/dmask como monta gpt-auto la ESP
mkdir -p "${mnt}/boot"
mount -o fmask=0077,dmask=0077 "${esp}" "${mnt}/boot"

# --- 4. Configuración previa al pacstrap (decisiones §5) ----------------------
# Solo ficheros sin dueño, o que pacman no pisa: así el initramfs que genera
# el hook de mkinitcpio al final del pacstrap ya sale correcto, una sola vez.

step "Writing configuration needed by the initramfs"
mkdir -p "${mnt}"/etc/{mkinitcpio.conf.d,kernel}

# Teclado de consola (Cal §11), lo usa sd-vconsole para la frase de LUKS
printf 'KEYMAP=%s\nXKBLAYOUT=%s\nXKBMODEL=pc105\n' "${console_keymap}" "${xkbmap}" \
    > "${mnt}/etc/vconsole.conf"

# HOOKS en un drop-in, sin editar mkinitcpio.conf (del paquete). keyboard
# antes de autodetect (como NCI), sin kms y plymouth solo si se instala (como
# Calamares, Cal §20)
plymouth_hook=""
installs plymouth && plymouth_hook="plymouth "
echo "HOOKS=(base systemd keyboard autodetect microcode modconf block sd-vconsole ${plymouth_hook}sd-encrypt filesystems)" \
    > "${mnt}/etc/mkinitcpio.conf.d/90-pixmatic.conf"

# cmdline completa, sin root= (gpt-auto): mkinitcpio la mete en la UKI. Los
# parámetros de Calamares (bootloader.conf: quiet nowatchdog; splash si hay
# plymouth) una sola vez, más los nuestros (decisiones §4 y §9)
splash=""
installs plymouth && splash=" splash"
echo "rw rootflags=${opts} zswap.enabled=0 nowatchdog quiet${splash}" > "${mnt}/etc/kernel/cmdline"

# Arranque directo con UKI, sin gestor de arranque (decisiones §9): el preset
# de linux-cachyos es el de la plantilla de mkinitcpio 42 (hook.preset, solo
# "default", sin fallback) con default_uki en lugar de default_image. El hook
# de mkinitcpio solo crea el preset si no existe, así que la UKI sale en el
# pacstrap, una sola vez. ALL_kver sigue en /boot: mkinitcpio lee de ahí la
# versión del kernel (el hook copia el vmlinuz a la ESP, aunque no se use).
mkdir -p "${mnt}"/{etc/mkinitcpio.d,boot/EFI/Linux}
cat > "${mnt}/etc/mkinitcpio.d/linux-cachyos.preset" <<'EOF'
# mkinitcpio preset file for the 'linux-cachyos' package
# pixmatic-install: UKI en la ESP, arrancada directamente por el firmware

ALL_kver="/boot/vmlinuz-linux-cachyos"

PRESETS=('default')

default_uki="/boot/EFI/Linux/cachyos-linux-cachyos.efi"
EOF

# gpt-auto ya desbloquea la raíz (/dev/gpt-auto-root-luks -> mapper "root"),
# pero no admite opciones (ignora rd.luks.options=). Esta línea genera la
# misma unidad systemd-cryptsetup@root.service con try-empty-password, y
# prevalece sobre la de gpt-auto. sd-encrypt (mkinitcpio 42) copia al
# initramfs las líneas de /etc/crypttab con x-initrd.attach (crypttab.initramfs
# está obsoleto). Se escribe antes del pacstrap para que el initramfs se
# genere una sola vez; el /etc/crypttab del paquete filesystem queda como
# .pacnew y tras el pacstrap se recupera con esta línea al final.
crypt_line="${mapper} /dev/gpt-auto-root-luks none try-empty-password=yes,x-initrd.attach"
echo "${crypt_line}" > "${mnt}/etc/crypttab"

# Plymouth como Calamares (Cal §18), si se instala: tema (cachyos con GPU
# AMD; solo si su paquete se instala) y UseSimpledrm=1. Plymouth no lee
# drop-ins, así que se escribe plymouthd.conf; pacman dejará el del paquete
# (solo comentarios) como .pacnew, que se borra tras el pacstrap.
if installs plymouth; then
    theme="cachyos-bootanimation"; theme_pkg="cachyos-plymouth-bootanimation"
    if chwd --check amd &> /dev/null; then
        theme="cachyos"; theme_pkg="cachyos-plymouth-theme"
    fi
    mkdir -p "${mnt}/etc/plymouth"
    {
        echo "[Daemon]"
        if installs "${theme_pkg}"; then echo "Theme=${theme}"; fi
        echo "UseSimpledrm=1"
    } > "${mnt}/etc/plymouth/plymouthd.conf"
fi

# --- 5. pacstrap único (decisiones §5) ----------------------------------------

step "Installing packages"
# Paquetes descargados en la caché del target (se vacía al final). Llavero y
# mirrorlist de Arch se copian del live. Ante fallos de red se repite el mismo
# pacstrap: la caché conserva lo ya descargado.
for attempt in 1 2 3; do
    pacstrap -C "${pacconf}" "${mnt}" "${pkgs[@]}" && break
    (( attempt < 3 )) || die "pacstrap failed"
    echo "pacstrap failed, retrying (${attempt}/3)"
done

rm -f "${mnt}/etc/plymouth/plymouthd.conf.pacnew"
if [[ -f ${mnt}/etc/crypttab.pacnew ]]; then
    mv "${mnt}/etc/crypttab.pacnew" "${mnt}/etc/crypttab"
    echo "${crypt_line}" >> "${mnt}/etc/crypttab"
fi
# pacman.conf y mirrorlists de CachyOS ordenados, sobre los de los paquetes
# (después del pacstrap para que no salgan .pacnew; NCI §4)
cp "${target_conf}" "${mnt}/etc/pacman.conf"
cp /etc/pacman.d/cachyos*-mirrorlist "${mnt}/etc/pacman.d/"

# --- 6. Ajustes del sistema (Cal §8-12, §24, §28, §30) ------------------------

step "Configuring the system"
# machine-id nuevo y enlace de dbus (gucc::machine_id::reset)
rm -f "${mnt}/etc/machine-id" "${mnt}/var/lib/dbus/machine-id"
systemd-machine-id-setup --root="${mnt}"
mkdir -p "${mnt}/var/lib/dbus"
ln -s /etc/machine-id "${mnt}/var/lib/dbus/machine-id"

# Zona horaria y reloj en UTC (escribe /etc/adjtime). Un fallo solo avisa,
# como gucc::hwclock::set_hwclock_utc (Cal §24)
ln -sf "/usr/share/zoneinfo/${timezone}" "${mnt}/etc/localtime"
in_target hwclock --systohc --utc || in_target hwclock --systohc --utc --directisa \
    || echo "WARNING: hwclock failed"

# Locales: bloque al final de locale.gen con en_US y el elegido (Cal §12)
printf '\n###\n#\n# Locales enabled by pixmatic-install\nen_US.UTF-8 UTF-8\n%s UTF-8\n' \
    "${locale}" >> "${mnt}/etc/locale.gen"
in_target locale-gen
{
    echo "LANG=${locale}"
    for v in ADDRESS IDENTIFICATION MEASUREMENT MONETARY NAME NUMERIC PAPER TELEPHONE TIME; do
        echo "LC_${v}=${locale}"
    done
} > "${mnt}/etc/locale.conf"

# Teclado de X11/Wayland, como lo escribe Calamares (Cal §11)
mkdir -p "${mnt}/etc/X11/xorg.conf.d"
cat > "${mnt}/etc/X11/xorg.conf.d/00-keyboard.conf" <<EOF
# Read and parsed by systemd-localed. It's probably wise not to edit this file
# manually too freely.
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "${xkbmap}"
        Option "XkbVariant" ""
EndSection
EOF

# Hostname y hosts (Cal §9)
echo "${hostname}" > "${mnt}/etc/hostname"
cat > "${mnt}/etc/hosts" <<EOF
# Standard host addresses
127.0.0.1  localhost
::1        localhost ip6-localhost ip6-loopback
ff02::1    ip6-allnodes
ff02::2    ip6-allrouters
# This host address
127.0.1.1  ${hostname}
EOF

# sudo para el grupo wheel (Cal §9)
install -m 0440 /dev/stdin "${mnt}/etc/sudoers.d/10-installer" <<< '%wheel ALL=(ALL) ALL'

# Servicios que activa Calamares (Cal §28), sin ModemManager (decisiones §3).
# Como Calamares, se saltan los que no estén instalados (dependen de los
# grupos de additional_packages)
for unit in NetworkManager.service avahi-daemon.service systemd-timesyncd.service \
            fstrim.timer bluetooth.service cups.service; do
    if [[ -e ${mnt}/usr/lib/systemd/system/${unit} ]]; then
        systemctl --root="${mnt}" enable "${unit}"
    fi
done
# Display manager (grupo "Hyprland"). En Calamares lo activa dmcheck al ver
# sddm instalado: display-manager.service -> sddm.service, el mismo enlace
# que crea "enable" (Alias= de sddm.service). Sin el /etc/sddm.conf de
# Calamares, que no tiene efecto práctico (decisiones §7). default.target ya
# es graphical.target (el de systemd por defecto).
if [[ -e ${mnt}/usr/lib/systemd/system/sddm.service ]]; then
    systemctl --root="${mnt}" enable sddm.service
fi
# ufw (Cal §30): como Calamares, se activa si está instalado (subgrupo
# "firewall" de additional_packages). Las políticas por defecto del paquete
# ya son deny incoming / allow outgoing; se marca ENABLED=yes en vez de
# ejecutar "ufw enable", que dentro del chroot cargaría las reglas en el
# kernel del live y cortaría el SSH (Cal, hallazgo 8). Mismo estado final.
if installs ufw; then
    systemctl --root="${mnt}" enable ufw
    sed -i 's/^ENABLED=no$/ENABLED=yes/' "${mnt}/etc/ufw/ufw.conf"
fi
# sshd si openssh está instalado (subgrupo "Some applications selection").
# Desviación deliberada (decisiones §8): Calamares lo instala pero no lo
# activa. Con el sshd_config del paquete (root sin contraseña no entra; el
# usuario, con contraseña). Con ufw activo, el puerto 22 queda bloqueado.
if installs openssh; then
    systemctl --root="${mnt}" enable sshd.service
fi

# --- 7. Usuario (tras los paquetes: useradd -m copia el skel completo) --------

step "Creating user ${username}"
# Shell fish y grupos de Calamares (Cal §9, users.conf), incluido nopasswdlogin
in_target groupadd -r nopasswdlogin
in_target useradd -m -U -s /bin/fish -K UMASK=077 -c "${user_fullname}" \
    -G wheel,rfkill,sys,users,lp,video,network,storage,audio,nopasswdlogin "${username}"
# chpasswd usa yescrypt (ENCRYPT_METHOD de login.defs), como Calamares
printf '%s:%s\n' "${username}" "${user_pass}" root "${root_pass}" | in_target chpasswd

# Config de Hyprland sin dotfiles en /etc/skel (sin cachyos-hypr-noctalia,
# decisiones §7): la de ejemplo del paquete, la misma que Hyprland generaría
# en el primer arranque pero sin la línea "autogenerated" (aviso en
# pantalla), y con alacritty como terminal si está instalado (la de ejemplo
# usa kitty).
hypr_conf="${mnt}/home/${username}/.config/hypr/hyprland.lua"
if installs hyprland && [[ ! -e ${hypr_conf} ]]; then
    in_target runuser -u "${username}" -- \
        install -Dm644 /usr/share/hypr/hyprland.lua "${hypr_conf#"${mnt}"}"
    if installs alacritty && ! installs kitty; then
        sed -i 's/^local terminal\( *\)= "kitty"$/local terminal\1= "alacritty"/' "${hypr_conf}"
        grep -q '^local terminal *= "alacritty"$' "${hypr_conf}" \
            || echo "WARNING: terminal not set to alacritty in ${hypr_conf#"${mnt}"}" >&2
    fi
fi
# Teclado de Hyprland (corrección a los oficiales, decisiones §7): ni la
# config de cachyos-hypr-noctalia (copiada de /etc/skel por useradd -m) ni la
# de ejemplo fijan kb_layout (queda "us"). Se añade al final del hyprland.lua
# del usuario (el de /etc/skel es del paquete y no se toca): un hl.config
# posterior solo cambia las claves que nombra, como los overrides de usuario
# de Omarchy (omarchy:config/hypr/input.lua).
if [[ -f ${hypr_conf} ]]; then
    printf '\n-- pixmatic-install: distribución de teclado ("xkbmap" de settings.jsonc)\nhl.config({ input = { kb_layout = "%s" } })\n' \
        "${xkbmap}" >> "${hypr_conf}"
elif installs hyprland; then
    echo "WARNING: no ${hypr_conf#"${mnt}"}; Hyprland keyboard layout left as us" >&2
fi

# Inicio de sesión directo, sin display manager ni greeter (desviación,
# decisiones §7): getty@tty1 entra solo con el usuario (misma forma que el
# autologin.conf de upstream para liveuser en el live) y, con Hyprland, el
# login de fish en tty1 lanza start-hyprland (el Exec= de hyprland.desktop).
# Sin "exec": al salir de Hyprland se queda la consola en tty1. Con la raíz
# LUKS2 de contraseña vacía (paso 3) no hay ninguna autenticación hasta la
# Fase 5.
install -Dm644 /dev/stdin "${mnt}/etc/systemd/system/getty@tty1.service.d/autologin.conf" <<EOF
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --noreset --noclear --autologin ${username} - \${TERM}
EOF
if installs hyprland; then
    fish_conf="/home/${username}/.config/fish/conf.d/pixmatic-hyprland.fish"
    in_target runuser -u "${username}" -- mkdir -p "${fish_conf%/*}"
    install -m644 /dev/stdin "${mnt}${fish_conf}" <<'EOF'
# pixmatic-install: inicio de sesión directo en tty1 -> Hyprland
if status is-login; and test (tty) = /dev/tty1; and not set -q WAYLAND_DISPLAY
    start-hyprland
end
EOF
    in_target chown "${username}:${username}" "${fish_conf}"
fi

# Conexiones de NetworkManager guardadas en el live (p. ej. una wifi
# configurada con nmtui), sin pisar las que existan, y con los permisos del
# usuario del live pasados al nuevo (Cal §22)
shopt -s nullglob
conns=(/etc/NetworkManager/system-connections/*)
shopt -u nullglob
if (( ${#conns[@]} )) && [[ -d ${mnt}/etc/NetworkManager/system-connections ]]; then
    cp -n "${conns[@]}" "${mnt}/etc/NetworkManager/system-connections/"
    sed -i "s/^permissions=user:liveuser:;/permissions=user:${username}:;/" \
        "${mnt}"/etc/NetworkManager/system-connections/*
fi

# --- 8. Drivers según el hardware (Cal §13, NCI §12) --------------------------

step "Running chwd"
in_target chwd --autoconfigure

# --- 9. Arranque: UKI en la ESP + entrada UEFI (decisiones §9) ---------------

step "Creating the UEFI boot entry"
# Sin gestor de arranque: el firmware carga la UKI (systemd-stub + kernel +
# initramfs + cmdline), que generó mkinitcpio en el pacstrap (o chwd al
# regenerar). systemd-stub exporta LoaderDevicePartUUID, así que gpt-auto
# sigue encontrando la ESP y la raíz. La entrada (sin argumentos) la crea
# pixmatic_boot_entry de /usr/local/lib/pixmatic/boot.sh; la ESP es la
# partición 1. Si el firmware la pierde, pixmatic-rescue la recrea desde el
# live (menú: "Regenerar arranque").
[[ -s ${mnt}/boot/${pixmatic_uki} ]] || die "missing UKI in the ESP"
pixmatic_boot_entry "${disk}" 1

# --- 10. Limpieza (decisiones §3: target sin restos) --------------------------

step "Cleaning up"
rm -rf "${mnt}"/var/cache/pacman/pkg/*
pacnew="$(find "${mnt}/etc" -name '*.pacnew')"
[[ -z ${pacnew} ]] || echo "WARNING: .pacnew files left in the target:"$'\n'"${pacnew}"
echo "UKI:" && ls -l "${mnt}"/boot/EFI/Linux/
echo "cmdline: $(< "${mnt}/etc/kernel/cmdline")"
efibootmgr
cp "${log}" "${mnt}/var/log/pixmatic-install.log"   # para depurar (versión de pruebas)

umount -R "${mnt}"
cryptsetup close "${mapper}"
rm -rf "${work}"

step "Installation finished"
