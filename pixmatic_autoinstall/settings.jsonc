// Configuración de pixmatic-install, el instalador propio de la ISO pixmatic.
//
// build.sh lo valida y lo copia tal cual, con comentarios, a la ISO como
// /etc/pixmatic/settings.jsonc (permisos 600), para poder editarlo en el
// live. pixmatic-install elimina al leerlo las líneas que empiezan por //
// (se admiten espacios delante). Uso desde el live: el menú que se abre al
// entrar en tty1 o por SSH (sudo pixmatic-menu) permite editarlo, elegir el
// disco de una lista e instalar. El disco y qué hacer al terminar no se
// configuran aquí: se eligen en el menú.
//
// Solo hay claves para lo que es configurable. Lo demás lo fija el script
// según pixmatic_autoinstall/docs/decisiones.md: particionado (ESP de 2 GiB +
// LUKS2 + btrfs con subvolúmenes), linux-cachyos, UKI sin gestor de arranque, paquetes de
// Calamares, grupos del usuario, shell fish, reloj en UTC, chwd...
//
// Reglas de edición:
//  - Todas las opciones presentes; las no usadas, comentadas en su sitio con
//    descripción, valores y valor por defecto (comentar, no borrar).
//  - Solo comentarios de línea completa: nunca // al final de una línea.
//  - JSON estricto: sin coma tras el último elemento de un objeto o array.
//  - Las claves marcadas "NO IMPLEMENTADA" son de fases futuras: el script
//    aún no las lee.
//
// CONTRASEÑAS: el repo es público. user_pass y root_pass llevan CHANGEME
// hasta que definamos cómo inyectar secretos en la build; el instalador las
// usa tal cual, así que hay que cambiarlas (p. ej. en el live) antes de
// instalar.
{
    // ======================================================================
    // Usuarios
    // ======================================================================

    // Usuario a crear (shell fish, grupos de Calamares).
    // Valores: empieza por a-z o "_", sigue con a-z, 0-9, "_" o "-"; hasta
    // 32 caracteres. PENDIENTE.
    "user_name": "pixmatic",

    // Nombre completo del usuario (campo GECOS).
    // Valores: texto. Por defecto: vacío.
    // "user_fullname": "Pixmatic",

    // Contraseña del usuario. Se usa tal cual (no se pregunta).
    // Valores: texto plano.
    "user_pass": "a",

    // Contraseña de root. Se usa tal cual (no se pregunta).
    // Valores: texto plano.
    "root_pass": "a",

    // ======================================================================
    // Fases futuras (NO IMPLEMENTADAS)
    // (Antes de la sección Sistema para que su última clave, sin coma,
    // cierre el objeto: al descomentar una de estas no hay que tocar comas.)
    // ======================================================================

    // NO IMPLEMENTADA (Fase 3). Escritorio.
    // Valores: "none" | "hyprland". Por defecto: "none".
    // "desktop": "hyprland",

    // NO IMPLEMENTADA (Fases 3-4). Personalización tomada de Omarchy (sin
    // aplicar Omarchy): aplicaciones y tema visual. Las listas tendrán
    // todas las aplicaciones de install/omarchy-base.packages y todos los
    // temas de themes/, comentados.
    // "omarchy": {
    //     "enabled": false,
    //     "packages": [],
    //     "theme": "tokyo-night"
    // },

    // NO IMPLEMENTADA (Fase 5). Cifrado: hoy LUKS2 con contraseña vacía.
    // "luks": {
    //     "tpm2": true,
    //     "recovery_key": "show"
    // },

    // NO IMPLEMENTADA (Fase 6). Repositorios a restaurar.
    // Valores: URL de git.
    // "etckeeper_repo": "",
    // "chezmoi_repo": "",
    // ======================================================================
    // Sistema
    // ======================================================================

    // Nombre de la máquina (/etc/hostname).
    // Valores: etiquetas separadas por "." de 1-63 caracteres A-Z, a-z, 0-9
    // y "-" (sin "-" al principio ni al final). PENDIENTE.
    "hostname": "pixmatic",

    // Locale del sistema: LANG y todas las LC_* de /etc/locale.conf. Se
    // activa en /etc/locale.gen junto con en_US.UTF-8 (como Calamares).
    // Valores: una entrada de /etc/locale.gen sin el charset final
    // ("es_ES.UTF-8", "en_US.UTF-8"...).
    "locale": "es_ES.UTF-8",

    // Distribución de teclado del entorno gráfico
    // (/etc/X11/xorg.conf.d/00-keyboard.conf y, con Hyprland, kb_layout en
    // ~/.config/hypr/hyprland.lua del usuario).
    // Valores: los de "localectl list-x11-keymap-layouts" ("es", "us",
    // "latam"...).
    "xkbmap": "es",

    // Teclado de la consola y de la frase de LUKS (/etc/vconsole.conf).
    // Valores: los de "localectl list-keymaps" ("es", "us", "la-latin1"...).
    // Por defecto: el valor de xkbmap (vale para "es" o "us", no para
    // distribuciones cuyo nombre de consola es otro, como "latam").
    // "console_keymap": "es",

    // Zona horaria (/etc/localtime).
    // Valores: los de "timedatectl list-timezones" ("Europe/Madrid"...).
    "timezone": "Europe/Madrid",

    // Grupos de paquetes de netinstall de Calamares (cachyos-staging), dentro
    // del pacstrap único: grupo -> (subgrupo ->) paquete: true | false. Se
    // instalan los paquetes a true, como al marcar/desmarcar en Calamares. Un
    // grupo con todos sus paquetes a false no instala nada: en Calamares el
    // grupo se desmarca solo al desmarcar todos sus paquetes, y no tiene otro
    // efecto (PackageTreeItem.cpp:210-238). Un grupo comentado tampoco se
    // instala. Se pueden añadir paquetes a un grupo (se validan antes de borrar
    // el disco).
    // Valores de este fichero: están todos los paquetes de los grupos
    // preseleccionados en Calamares y de los opcionales sin escritorio (estos,
    // sin sus paquetes gráficos); de los de escritorio, solo Firefox e
    // Hyprland (fuera también "Accessibility Tools": orca y mousetweaks).
    // "CachyOS required" va fijo en el script. Sistema mínimo (2026-11-22):
    // a true solo lo imprescindible (firmware, una fuente, micro con cachyos-micro-settings, Hyprland y alacritty) y,
    // para el uso del equipo (multimedia y juegos, 2026-11-22), audio con
    // PipeWire, códecs de GStreamer, Bluetooth (mandos), fuentes de emoji,
    // CJK y Liberation, y xdg-utils/xdg-user-dirs; lo demás, a false: es una
    // desviación deliberada respecto a Calamares, que los preselecciona
    // (decisiones §8). Estas listas replican las de Calamares: lo que no esté
    // en ellas va en extra_packages. Excepción, por ser paquete del sistema:
    // "Snapper" (cachyos-snapper-support).
    // Sin "cachyos-fish-config" se instala fish (la shell del usuario); sin
    // "plymouth", el initramfs se genera sin su hook. Los servicios de
    // Calamares se activan solo si su paquete está instalado: con "ufw", el
    // cortafuegos queda activo (deny incoming, allow outgoing; bloquea el
    // puerto 22). Con "openssh", sshd queda activo (desviación: Calamares no
    // lo activa), con la config del paquete: el usuario entra con contraseña;
    // root, no. Sin "networkmanager", la red va con systemd-networkd (DHCP
    // en toda Ethernet física, sin Wi-Fi) y systemd-resolved (desviación,
    // decisiones §8).
    "additional_packages": {
        "CachyOS Packages": {
            "cachyos-hello": false,
            "cachyos-kernel-manager": false,
            "cachyos-packageinstaller": false,
            "cachyos-settings": true,
            "cachyos-micro-settings": true,
            "cachyos-wallpapers": false
        },
        "CachyOS shell configuration": {
            "cachyos-fish-config": false,
            "cachyos-zsh-config": false
        },
        "Base-devel + Common packages": {
            "Network": {
                "dnsmasq": false,
                // No es un paquete: pacman instala bind, que lo provee.
                "dnsutils": false,
                "ethtool": false,
                "iwd": false,
                "modemmanager": false,
                "networkmanager": false,
                "networkmanager-openvpn": false,
                "nss-mdns": false,
                "usb_modeswitch": false,
                "wpa_supplicant": false,
                "wireless-regdb": true,
                "xl2tpd": false
            },
            "firewall": {
                "ufw": false,
                "ufw-extras": false
            },
            "bluetooth": {
                "bluez": true,
                "bluez-hid2hci": false,
                "bluez-libs": false,
                "bluez-utils": true,
                "bluez-obex": false
            },
            "packages management": {
                "pacman-contrib": false,
                "pkgfile": false,
                "rebuild-detector": false,
                "reflector": false,
                "shelly": false
            },
            "desktop integration": {
                "accountsservice": false,
                "bash-completion": false,
                "ffmpegthumbnailer": false,
                "gst-libav": true,
                "gst-plugin-dav1d": true,
                "gst-plugin-pipewire": true,
                "gst-plugins-bad": true,
                "gst-plugins-ugly": true,
                "libdvdcss": false,
                "libgsf": false,
                "libopenraw": false,
                "plocate": false,
                "poppler-glib": false,
                // Metapaquete: los 16 vlc-plugin* (vlc-plugins-base, -extra,
                // -video-output, -visualization y vlc-plugin-*).
                "vlc-plugins-all": false,
                "xdg-user-dirs": true,
                "xdg-utils": true
            },
            "filesystem": {
                "efitools": false,
                "nfs-utils": false,
                "nilfs-utils": false,
                "smartmontools": false,
                "unrar": false,
                "unzip": false
            },
            "fonts": {
                "awesome-terminal-fonts": false,
                "noto-fonts-emoji": true,
                "cantarell-fonts": false,
                "noto-fonts": true,
                "ttf-bitstream-vera": false,
                "ttf-dejavu": false,
                "ttf-liberation": true,
                "ttf-opensans": false,
                "ttf-meslo-nerd": false,
                "noto-fonts-cjk": true
            },
            "audio": {
                "alsa-firmware": false,
                "alsa-plugins": false,
                "alsa-utils": true,
                "pavucontrol": false,
                "pipewire-pulse": true,
                "wireplumber": true,
                "pipewire-alsa": true,
                "realtime-privileges": true
            },
            "hardware": {
                "dmidecode": false,
                "dmraid": false,
                "hdparm": false,
                "hwdetect": false,
                // Metapaquete: los 12 linux-firmware-* (amd, amdgpu, atheros, broadcom,
                // cirrus, intel, mediatek, nvidia, other, radeon, realtek, ti). Va
                // también fijo en el pacstrap.
                "linux-firmware": true,
                "lsscsi": false,
                "mesa-utils": false,
                "mtools": false,
                "sg3_utils": false,
                "sof-firmware": true
            },
            "power": {
                "cpupower": false,
                "power-profiles-daemon": false,
                "upower": false
            },
            "Some applications selection": {
                "alacritty": true,
                "btop": false,
                "duf": false,
                "fsarchiver": false,
                "git": false,
                "glances": false,
                "hwinfo": false,
                "meld": false,
                "nano-syntax-highlighting": false,
                "fastfetch": false,
                "pv": false,
                "python-defusedxml": false,
                "python-packaging": false,
                "rsync": false,
                "wget": false,
                "ripgrep": false,
                "micro": false,
                "nano": false,
                "vim": false,
                "openssh": false
            }
        },
        "Plymouth": {
            "plymouth": false,
            "cachyos-plymouth-bootanimation": false,
            "cachyos-plymouth-theme": false
        },
        // Escritorio. A false en el sistema mínimo.
        "Firefox and language package": {
            "firefox": false,
            // Calamares añade firefox-i18n-$LOCALE; que $LOCALE sea es-es está
            // pendiente de confirmar.
            "firefox-i18n-es-es": false
        },
        // Escritorio. Desviación (decisiones §7): sin Noctalia
        // (cachyos-hypr-noctalia) ni SDDM ni ningún otro greeter: el usuario
        // entra solo en tty1 (getty con --autologin) y su login de fish
        // lanza start-hyprland. Sin dotfiles en /etc/skel, el usuario recibe la
        // config de ejemplo de Hyprland (/usr/share/hypr/hyprland.lua) con
        // alacritty como terminal si está instalado y la distribución de
        // "xkbmap" (los oficiales la dejan en "us"). Pendiente de la Fase 3:
        // aplicaciones y tema de Omarchy.
        "Hyprland": {
            "hyprland": true,
            "dolphin": false,
            "kitty": false,
            "sddm": false,
            "cachyos-hypr-noctalia": false
        },
        // Opcional en Calamares, sin system-config-printer (gráfico). Con cups se
        // activa cups.service, como Calamares.
        "Printing-Support": {
            "cups": false,
            "cups-filters": false,
            "cups-pdf": false,
            "foomatic-db": false,
            "foomatic-db-engine": false,
            "foomatic-db-gutenprint-ppds": false,
            "foomatic-db-nonfree": false,
            "foomatic-db-nonfree-ppds": false,
            "foomatic-db-ppds": false,
            "ghostscript": false,
            "gsfonts": false,
            "gutenprint": false
        },
        // Opcional en Calamares, sin python-pyqt5 (solo lo usa la interfaz
        // gráfica de hplip).
        "Support for HP Printer/Scanner": {
            "hplip": false,
            "python-reportlab": false,
            "cups": false,
            "cups-filters": false,
            "cups-pdf": false
        },
        // No es de Calamares (excepción, decisiones §8): con
        // cachyos-snapper-support (snapper + snap-pac), la config "root" de
        // snapper con la plantilla de CachyOS, snapper-cleanup.timer,
        // instantáneas antes y después de cada operación de pacman, y la
        // instantánea de instalación de Calamares/NCI ("Fresh CachyOS
        // Installation", número en /etc/cachyos/installation-snapshot). Sin
        // él, snapper queda instalado pero sin configurar (como NCI).
        // Incompatible con timeshift.
        "Snapper": {
            "cachyos-snapper-support": true
        }
    },

    // Botón "Install gaming packages" de cachyos-hello (decisiones §8):
    // cachyos-gaming-meta (Wine, Proton, umu, winetricks, protontricks y
    // librerías de 64 y 32 bits) y cachyos-gaming-applications (Steam,
    // Lutris, Heroic, Faugus, gamescope, MangoHud, GOverlay y fuentes), sin
    // activar servicios ni tocar configuración. Van en el pacstrap único,
    // con vulkan-driver y lib32-vulkan-driver dados por instalados (los pone
    // chwd después; si no, pacman elegiría nvidia-390xx-utils): el
    // resultado es el mismo que con Hello. Donde pacman haría
    // elegir entre paquetes equivalentes, toma su opción por defecto (la de
    // pulsar Intro): la fuente nerd de goverlay sale
    // otf-atkinsonhyperlegiblemono-nerd, salvo que ya haya otra instalada.
    // Valores: true | false. Por defecto: false.
    "gaming_packages": false,

    // Paquetes adicionales, dentro del pacstrap único. Solo de los repos del
    // pacman.conf de la instalación (CachyOS, Arch y [chaotic-aur]; no el
    // AUR); se validan antes de borrar el disco.
    // Valores: array de nombres de paquete. Por defecto: [].
    "extra_packages": []
}
